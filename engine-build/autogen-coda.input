--host=x86_64-pc-cygwin
--with-strawberry-perl-portable=C:/lo/spp
--with-parallelism=4
--enable-ccache
--enable-python=fully-internal
--disable-pch
--enable-mergelibs
--enable-release-build
--with-visual-studio=2022
--without-lxml
--with-vendor=Dung Office
--disable-gpgmepp
--disable-lotuswordpro
--disable-lpsolve
--disable-mariadb-sdbc
--disable-poppler
--disable-postgresql-sdbc
--with-theme=colibre
--without-java
--without-junit
--disable-ext-nlpsolver
--disable-ext-wiki-publisher
--disable-report-builder
--disable-scripting-beanshell
--disable-scripting-javascript
--disable-avmedia
--disable-opengl
--disable-skia
--enable-cairo-rgba
--enable-headless
--disable-breakpad
--disable-cli
--disable-firebird-sdbc
--disable-librelogo
--disable-odk
--disable-online-update
--disable-opencl
--disable-sal-log
--disable-sdremote
--disable-sdremote-bluetooth
--without-myspell-dicts
--without-galleries
--without-help
--without-templates
--with-fonts
--with-docrepair-fonts
--disable-noto-font
--without-doxygen
